# Local development only. Docker services override host names in compose.yaml.
DATABASE_URL=postgresql+psycopg://shortform:local-dev-only@localhost:5432/shortform
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
VIDEO_DATA_DIR=.artifacts/jobs
ENABLE_PAID_AI=false
# Enable only after confirming the Groq account is on Free (no billing upgrade).
ENABLE_FREE_AI=false
GROQ_FREE_TIER_CONFIRMED=false
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=groq
RECOMMENDATION_PROVIDER=none
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
OPENAI_API_KEY=
RECOMMENDATION_MODEL=gpt-5.6-terra
# SNS is local-only and opt-in. Never use test fixture credentials for real OAuth.
ENABLE_SNS_UPLOAD=false
SNS_ORIGIN=http://localhost:8000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SNS_TOKEN_KEY=
